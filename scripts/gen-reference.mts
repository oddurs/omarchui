// Extracts the parts of research/omarchy/facts.json the demo reads at runtime into a small,
// typed module, so the browser never loads the full research file.
// Usage: node scripts/gen-reference.mts [--check]
import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";

const root = path.resolve(import.meta.dirname, "..");
type Node = { id: string; name: string; command: string | null; provider?: string | null; source: string; children?: Node[] };
type Binding = { mods: string[] | null; key: string; description: string | null; action: string; group: string; source: string };
type Row = { where: string; property?: string; value?: string; sizes?: string; source: string };
const facts = JSON.parse(readFileSync(path.join(root, "research/omarchy/facts.json"), "utf8")) as {
  commit: string;
  version: string;
  menu: Node[];
  bindings: Binding[];
  bar: Record<string, unknown>;
  spacing: Row[];
  typography: Row[];
};

const MOD_ORDER = ["SUPER", "ALT", "CTRL", "SHIFT"];
const KEY: Record<string, string> = {
  RETURN: "Return",
  SPACE: "Space",
  ESCAPE: "Escape",
  LEFT: "Left",
  RIGHT: "Right",
  UP: "Up",
  DOWN: "Down",
  MINUS: "Minus",
  EQUAL: "Equal",
  TAB: "Tab",
  COMMA: "Comma",
  PERIOD: "Period",
  SLASH: "Slash",
  DELETE: "Delete",
  BACKSPACE: "Backspace",
  PRINT: "Print",
};
const title = (m: string) => m[0] + m.slice(1).toLowerCase();
function chord(b: Binding): string {
  const mods = [...(b.mods ?? [])].map((m) => m.toUpperCase()).sort((a, c) => MOD_ORDER.indexOf(a) - MOD_ORDER.indexOf(c));
  const k = KEY[b.key.toUpperCase()] ?? (b.key.length === 1 ? b.key.toUpperCase() : b.key);
  return [...mods.map(title), k].join("+");
}

type Ref = { id: string; name: string; cmd?: string; provider?: string; src: string; kids?: Ref[] };
const compact = (n: Node): Ref => ({
  id: n.id,
  name: n.name,
  ...(n.command ? { cmd: n.command } : {}),
  ...(n.provider ? { provider: n.provider } : {}),
  src: n.source,
  ...(n.children?.length ? { kids: n.children.map(compact) } : {}),
});

const data = {
  REF_COMMIT: facts.commit,
  REF_VERSION: facts.version,
  REF_MENU: facts.menu.map(compact),
  REF_BINDINGS: facts.bindings.map((b) => ({ chord: chord(b), desc: b.description ?? b.action, action: b.action, group: b.group, src: b.source })),
  REF_BAR: {
    left: facts.bar.modulesLeft,
    centerBegin: facts.bar.modulesCenterBegin,
    center: facts.bar.modulesCenter,
    centerEnd: facts.bar.modulesCenterEnd,
    right: facts.bar.modulesRight,
    src: facts.bar.modulesSource,
  },
  REF_SPACING: facts.spacing.map((r) => ({ where: r.where, property: r.property ?? "", value: r.value ?? "", src: r.source })),
  REF_TYPE: facts.typography.map((r) => ({ where: r.where, sizes: r.sizes ?? "", src: r.source })),
};

const out = `// Generated by scripts/gen-reference.mts from research/omarchy/facts.json. Do not edit.
export type RefMenu = { id: string; name: string; cmd?: string; provider?: string; src: string; kids?: RefMenu[] };
export type RefBinding = { chord: string; desc: string; action: string; group: string; src: string };
export type RefRow = { where: string; property: string; value: string; src: string };

${Object.entries(data)
  .map(([k, v]) => {
    const type = k === "REF_MENU" ? ": RefMenu[]" : k === "REF_BINDINGS" ? ": RefBinding[]" : k === "REF_SPACING" ? ": RefRow[]" : "";
    return `export const ${k}${type} = ${JSON.stringify(v)};`;
  })
  .join("\n\n")}
`;

const target = path.join(root, "lib/reference.generated.ts");
if (process.argv.includes("--check")) {
  if (readFileSync(target, "utf8") !== out) {
    console.error("lib/reference.generated.ts is stale. Run: node scripts/gen-reference.mts");
    process.exit(1);
  }
} else {
  writeFileSync(target, out);
  console.log(`wrote reference: ${data.REF_BINDINGS.length} bindings, ${JSON.stringify(data.REF_MENU).length} bytes of menu`);
}
