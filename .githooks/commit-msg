#!/bin/sh
# Conventional Commits, and no tool attribution in the message.
set -eu
msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | head -n 1)

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|chore|docs|perf|refactor|test|build|ci|style|revert)(\([a-z0-9._/-]+\))?!?: [^ ].*[^.]$'; then
  echo "commit-msg: subject must be a Conventional Commit, e.g. 'feat(demo): add a lock screen'" >&2
  echo "  got: $subject" >&2
  exit 1
fi
if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} characters; keep it to 72" >&2
  exit 1
fi
if grep -v '^#' "$msg_file" | grep -Eiq '(co-authored-by:.*(claude|anthropic|openai|chatgpt|copilot|gpt)|generated (with|by) .*(claude|ai\b|chatgpt|copilot|gpt)|noreply@anthropic\.com|🤖)'; then
  echo "commit-msg: remove tool attribution; the work is published under the author's name" >&2
  exit 1
fi
